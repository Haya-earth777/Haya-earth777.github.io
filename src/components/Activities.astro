---
import { activities, type YearMonth } from '../data/profile';
import { formatYM } from '../lib/timeline';
import SectionHead from './SectionHead.astro';

const isYM = (v: string): v is YearMonth => /^\d{4}-\d{1,2}$/.test(v);
// 新しい順に並べる（年だけのものは、その年の月が分かるものより後ろ）
const sortKey = (v: string) => {
  const [y, m] = v.split('-').map(Number);
  return y * 100 + (m ?? 0);
};
const sorted = [...activities].sort((a, b) => sortKey(b.when) - sortKey(a.when));
---
<section class="grid grid-cols-[220px_minmax(0,1fr)] gap-12 py-[88px] border-t border-line tab:grid-cols-[minmax(0,1fr)] tab:gap-7 tab:py-16" aria-labelledby="h-acts">
  <SectionHead id="h-acts" title="活動" sub="登壇・制作・発信" />
  <ol class="list-none m-0 p-0 border-t border-fg" data-reveal>
    {sorted.map((a) => (
      <li class="grid grid-cols-[110px_72px_minmax(0,1fr)] gap-5 items-baseline py-[18px] border-b border-line last:border-b-0 sp:grid-cols-[auto_minmax(0,1fr)] sp:gap-x-3 sp:gap-y-1.5">
        <time class="font-display font-semibold text-[16px] tabular-nums" datetime={a.when}>{isYM(a.when) ? formatYM(a.when) : a.when}</time>
        <span class="justify-self-start inline-flex items-center gap-[5px] text-[12px] font-bold text-accent shadow-[inset_0_0_0_1px_var(--color-accent)] px-2.5 rounded-full whitespace-nowrap"><svg class="ic w-[13px] h-[13px] [--ic-stroke:2]" aria-hidden="true"><use href={`#i-${a.kind.icon}`} /></svg>{a.kind.label}</span>
        <span class="grid gap-0.5 min-w-0 sp:col-[1/-1]"><b class="text-[16px] font-bold leading-[1.6]">{a.title}</b>{a.text && <span class="text-[14px] text-muted">{a.text}</span>}</span>
      </li>
    ))}
  </ol>
</section>
