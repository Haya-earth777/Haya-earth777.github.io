---
import { activities, type Activity } from '../data/profile';
import SectionHead from './SectionHead.astro';

// 今も続けているものを「継続中」として先頭にまとめ（始めた順）、
// 残りは新しい順に年ごとにまとめる（同じ年の中では、月が分かるものを先に）
const sortKey = (v: string) => {
  const [y, m] = v.split('-').map(Number);
  return y * 100 + (m ?? 0);
};
const groups = new Map<string, Activity[]>();
const add = (label: string, a: Activity) => groups.set(label, [...(groups.get(label) ?? []), a]);
activities.filter((a) => a.ongoing).sort((a, b) => sortKey(a.when) - sortKey(b.when)).forEach((a) => add('継続中', a));
activities.filter((a) => !a.ongoing).sort((a, b) => sortKey(b.when) - sortKey(a.when)).forEach((a) => add(a.when.slice(0, 4), a));
const since = (a: Activity) => (a.ongoing ? `${a.when.slice(0, 4)} 年から、` : '');
---
<section class="grid grid-cols-[220px_minmax(0,1fr)] gap-12 py-[88px] border-t border-line tab:grid-cols-[minmax(0,1fr)] tab:gap-7 tab:py-16" aria-labelledby="h-acts" data-line>
  <SectionHead id="h-acts" title="活動" sub="登壇・制作・発信" />
  <ol class="list-none m-0 p-0 border-t border-fg" data-reveal data-line>
    {[...groups].map(([label, items]) => (
      <li class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-5 border-b border-line last:border-b-0 sp:grid-cols-[minmax(0,1fr)] sp:gap-3" data-line>
        {label === '継続中'
          ? <span class="font-display font-semibold text-[16px]">{label}</span>
          : <time class="font-display font-semibold text-[16px] tabular-nums" datetime={label}>{label}</time>}
        <ul class="list-none m-0 p-0 grid gap-4 sp:gap-[22px]">
          {items.map((a) => (
            <li class="grid grid-cols-[72px_minmax(0,1fr)] gap-5 items-baseline sp:grid-cols-[auto_minmax(0,1fr)] sp:gap-x-3 sp:gap-y-1.5">
              <span class="justify-self-start inline-flex items-center gap-[5px] text-[12px] font-bold text-accent shadow-[inset_0_0_0_1px_var(--color-accent)] px-2.5 rounded-full whitespace-nowrap"><svg class="ic w-[13px] h-[13px] [--ic-stroke:2]" aria-hidden="true"><use href={`#i-${a.kind.icon}`} /></svg>{a.kind.label}</span>
              <span class="grid gap-0.5 min-w-0 sp:col-[1/-1]"><b class="text-[16px] font-bold leading-[1.6]">{a.url
                ? <a class="group/l underline-offset-4 hover:underline" href={a.url} target="_blank" rel="noopener noreferrer">{a.title}<i class="not-italic inline-block ml-1 text-[13px] text-muted [transition:transform_.3s_var(--ease-soft)] group-hover/l:[transform:translate(2px,-2px)]" aria-hidden="true">↗</i></a>
                : a.title}</b>{a.text && <span class="text-[14px] text-muted">{since(a)}{a.text}</span>}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
