---
import { activities, type Activity } from '../data/profile';
import SectionHead from './SectionHead.astro';

// 新しい順に並べて、年ごとにまとめる（同じ年の中では、月が分かるものを先に）
const sortKey = (v: string) => {
  const [y, m] = v.split('-').map(Number);
  return y * 100 + (m ?? 0);
};
const years = new Map<string, Activity[]>();
for (const a of [...activities].sort((a, b) => sortKey(b.when) - sortKey(a.when))) {
  const y = a.when.slice(0, 4);
  years.set(y, [...(years.get(y) ?? []), a]);
}
---
<section class="grid grid-cols-[220px_minmax(0,1fr)] gap-12 py-[88px] border-t border-line tab:grid-cols-[minmax(0,1fr)] tab:gap-7 tab:py-16" aria-labelledby="h-acts">
  <SectionHead id="h-acts" title="活動" sub="登壇・制作・発信" />
  <ol class="list-none m-0 p-0 border-t border-fg" data-reveal>
    {[...years].map(([year, items]) => (
      <li class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-5 border-b border-line last:border-b-0 sp:grid-cols-[minmax(0,1fr)] sp:gap-3">
        <time class="font-display font-semibold text-[16px] tabular-nums" datetime={year}>{year}</time>
        <ul class="list-none m-0 p-0 grid gap-4 sp:gap-[22px]">
          {items.map((a) => (
            <li class="grid grid-cols-[72px_minmax(0,1fr)] gap-5 items-baseline sp:grid-cols-[auto_minmax(0,1fr)] sp:gap-x-3 sp:gap-y-1.5">
              <span class="justify-self-start inline-flex items-center gap-[5px] text-[12px] font-bold text-accent shadow-[inset_0_0_0_1px_var(--color-accent)] px-2.5 rounded-full whitespace-nowrap"><svg class="ic w-[13px] h-[13px] [--ic-stroke:2]" aria-hidden="true"><use href={`#i-${a.kind.icon}`} /></svg>{a.kind.label}</span>
              <span class="grid gap-0.5 min-w-0 sp:col-[1/-1]"><b class="text-[16px] font-bold leading-[1.6]">{a.title}</b>{a.text && <span class="text-[14px] text-muted">{a.text}</span>}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
