---
import { activities, type Activity } from '../data/profile';
import SectionHead from './SectionHead.astro';
import { splitCount } from '../lib/count';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

// リンク先の OGP（scripts/fetch-og.mjs がビルド前に取得）。取得できなかったものは画像なしのカードにする
type Og = { title?: string; image?: string };
const ogFile = join(process.cwd(), 'src', 'data', 'og.json');
const og: Record<string, Og> = existsSync(ogFile) ? JSON.parse(readFileSync(ogFile, 'utf8')) : {};
const ogImage = (url: string) => {
  const image = og[url]?.image;
  return image && existsSync(join(process.cwd(), 'public', image)) ? image : undefined;
};
// カードのタイトル。取得できなかったときと、X（「名前 (@ID) on X」）やこのサイト（「Haya」）のように
// タイトルだけでは中身が分からないものは、活動の名前を使う
const ogTitle = (a: Activity & { url: string }) => {
  const host = new URL(a.url).hostname;
  if (host === 'x.com' || host === 'twitter.com' || a.url.startsWith(Astro.site?.toString() ?? '')) return a.title;
  return og[a.url]?.title ?? a.title;
};

// 新しい順に年ごとにまとめる（同じ年の中では、月が分かるものを先に）
const sortKey = (v: string) => {
  const [y, m] = v.split('-').map(Number);
  return y * 100 + (m ?? 0);
};
const groups = new Map<string, Activity[]>();
const add = (label: string, a: Activity) => groups.set(label, [...(groups.get(label) ?? []), a]);
const sorted = [...activities].sort((a, b) => sortKey(b.when) - sortKey(a.when));
sorted.forEach((a) => add(a.when.slice(0, 4), a));
// リンクのある活動は、一覧の上に横スクロールのカードで並べる
const picks = sorted.filter((a): a is Activity & { url: string } => Boolean(a.url));
// カードが横から順に入ってくる動き（PC でスクロールして表示されたとき）
const slideIn = [0, 1, 2, 3, 4, 5, 6, 7].map((i) => [
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.08s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.16s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.24s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.32s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.4s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.48s_both]',
  'group-[.reveal:not(.pre)]/pick:animate-[slideIn_.9s_var(--ease-soft)_.56s_both]',
][i]);
const arrow = 'w-9 h-9 rounded-full border border-line bg-transparent text-fg grid place-items-center cursor-pointer [transition:border-color_.2s,opacity_.2s] fine:hover:border-fg disabled:opacity-30 disabled:cursor-default fine:disabled:hover:border-line';
---
<section class="grid grid-cols-[220px_minmax(0,1fr)] gap-12 py-[88px] border-t border-line tab:grid-cols-[minmax(0,1fr)] tab:gap-7 tab:py-16" aria-labelledby="h-acts" data-line>
  <SectionHead id="h-acts" title="活動" sub="登壇・制作・発信" />
  <div class="min-w-0">
  {picks.length > 0 && (
    <div class="group/pick mb-10" data-reveal data-carousel>
      <div class="flex justify-end gap-2 mb-3.5 touch:hidden">
          <button class={arrow} type="button" data-prev aria-label="前のカード" data-magnet><svg class="ic w-4 h-4 [--ic-stroke:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg></button>
          <button class={arrow} type="button" data-next aria-label="次のカード" data-magnet><svg class="ic w-4 h-4 [--ic-stroke:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></button>
      </div>
      <ul class="list-none m-0 p-0 flex gap-3.5 overflow-x-auto snap-x snap-mandatory overscroll-x-contain pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(to_right,#000_calc(100%-56px),transparent)] group-[.at-end]/pick:[mask-image:none] fine:cursor-grab [&.dragging]:cursor-grabbing [&.dragging]:snap-none" data-track aria-label="活動のリンク">
        {picks.map((a, i) => (
          <li class:list={['flex-none w-[260px] snap-start sp:w-[240px]', slideIn[Math.min(i, slideIn.length - 1)]]}>
            <a class="spot h-full grid grid-rows-[auto_1fr] rounded-xl border border-line bg-card overflow-hidden" href={a.url} target="_blank" rel="noopener noreferrer" draggable="false">
              <span class="relative aspect-[1.91/1] bg-accent-soft text-accent grid place-items-center">{ogImage(a.url)
                ? <img class="absolute inset-0 w-full h-full object-cover" src={ogImage(a.url)} alt="" loading="lazy" decoding="async" draggable="false" />
                : <svg class="ic w-6 h-6" aria-hidden="true"><use href="#i-link" /></svg>}</span>
              <span class="grid content-start gap-1 p-3.5 leading-[1.5]">
                <span class="inline-flex items-center gap-[5px] text-[12px] font-bold text-accent"><svg class="ic w-[13px] h-[13px] [--ic-stroke:2]" aria-hidden="true"><use href={`#i-${a.kind.icon}`} /></svg>{a.kind.label}・{a.when.slice(0, 4)}</span>
                <span class="text-[14px] font-bold text-fg line-clamp-2">{ogTitle(a)}</span>
                <span class="text-[12px] text-muted truncate">{new URL(a.url).hostname}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
  <ol class="list-none m-0 p-0 border-t border-fg" data-reveal data-line>
    {[...groups].map(([label, items]) => (
      <li class="grid grid-cols-[110px_minmax(0,1fr)] gap-5 items-baseline py-5 border-b border-line last:border-b-0 sp:grid-cols-[minmax(0,1fr)] sp:gap-3" data-line>
        <time class="font-display font-semibold text-[16px] tabular-nums" datetime={label}>{label}</time>
        <ul class="list-none m-0 p-0 grid gap-4 sp:gap-[22px]">
          {items.map((a) => (
            <li class="grid grid-cols-[72px_minmax(0,1fr)] gap-5 items-baseline sp:grid-cols-[auto_minmax(0,1fr)] sp:gap-x-3 sp:gap-y-1.5">
              <span class="justify-self-start inline-flex items-center gap-[5px] text-[12px] font-bold text-accent shadow-[inset_0_0_0_1px_var(--color-accent)] px-2.5 rounded-full whitespace-nowrap"><svg class="ic w-[13px] h-[13px] [--ic-stroke:2]" aria-hidden="true"><use href={`#i-${a.kind.icon}`} /></svg>{a.kind.label}</span>
              <span class="grid gap-0.5 min-w-0 sp:col-[1/-1]"><b class="text-[16px] font-bold leading-[1.6]">{a.url
                ? <a class="group/l underline-offset-4 fine:hover:underline" href={a.url} target="_blank" rel="noopener noreferrer">{a.title}<i class="not-italic inline-block ml-1 text-[13px] text-muted [transition:transform_.3s_var(--ease-soft)] fine:group-hover/l:[transform:translate(2px,-2px)]" aria-hidden="true">↗</i></a>
                : a.title}</b>{a.text && <span class="text-[14px] text-muted">{splitCount(a.text).map((p) => (typeof p === 'number' ? <span class="count" data-count={p}>{p}</span> : p))}</span>}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  </div>
</section>
