---
import { splitCount } from '../lib/count';
import { jobs, skills, type Brand } from '../data/profile';
import { barOf, formatYM, gridColsClass, nowColClass, yearLabels } from '../lib/timeline';
import BrandChip from './BrandChip.astro';
import SectionHead from './SectionHead.astro';

// 技術タグは、スキル欄と同じロゴ・頭文字で表示する
const brandByName = new Map<string, Brand>(
  skills.flatMap((row) => (row.kind === 'chips' ? row.items : [])).map((b) => [b.name, b]),
);
const brand = (name: string): Brand => brandByName.get(name) ?? { name };

const tracks = (['main', 'side'] as const).map((track) => ({
  track,
  label: track === 'main' ? '本業' : '副業',
  jobs: jobs.filter((j) => j.track === track).sort((a, b) => a.start.localeCompare(b.start)),
}));

const ymJa = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return `${y}年${m}月`;
};
const chartLabel =
  '2023年から現在までの職歴の期間。' +
  tracks
    .map((t) => `${t.label}は` + t.jobs.map((j) => `${j.short}（${ymJa(j.start)}〜${j.end ? ymJa(j.end) : '現在'}）`).join('と'))
    .join('。') +
  '。';

// 段（本業・副業）の行番号
const rowClass = ['row-[1]', 'row-[2]'];
// バーが左から伸びる順番（本業の 1 本目 → 2 本目 → 副業の 1 本目 → 2 本目 → 3 本目 → 4 本目）
const barTransition = [
  ['[transition:transform_1.1s_var(--ease-soft),filter_.2s]', '[transition:transform_1.1s_var(--ease-soft)_.2s,filter_.2s]'],
  ['[transition:transform_1.1s_var(--ease-soft)_.4s,filter_.2s]', '[transition:transform_1.1s_var(--ease-soft)_.55s,filter_.2s]', '[transition:transform_1.1s_var(--ease-soft)_.7s,filter_.2s]', '[transition:transform_1.1s_var(--ease-soft)_.85s,filter_.2s]'],
];
---
<section class="grid grid-cols-[220px_minmax(0,1fr)] gap-12 py-[88px] border-t border-line tab:grid-cols-[minmax(0,1fr)] tab:gap-7 tab:py-16" aria-labelledby="h-works" data-line>
  <SectionHead id="h-works" title="職歴" />
  <div>
    <div class="group/chart grid grid-cols-[36px_minmax(0,1fr)] grid-rows-[30px_30px_20px] gap-x-3.5 gap-y-2 mb-10 sp:grid-cols-[28px_minmax(0,1fr)] sp:gap-2" data-reveal role="img" aria-label={chartLabel}>
      {tracks.map((t, i) => <span class:list={['text-[12px] font-bold text-muted self-center', rowClass[i]]}>{t.label}</span>)}
      <div class:list={['col-[2] row-[1/3] grid', gridColsClass]} aria-hidden="true">{yearLabels.map((y) => <span class:list={['row-[1] [border-left:1px_solid_var(--color-line)]', y.className]}></span>)}</div>
      {tracks.map((t, i) => (
        <div class:list={['col-[2] grid', gridColsClass, rowClass[i]]}>
          {t.jobs.map((j, k) => {
            const bar = barOf(j, t.jobs[k - 1]);
            return (
              <a
                class:list={[
                  'bar row-[1] relative flex items-center rounded-full text-[12px] font-bold origin-left cursor-pointer hover:brightness-[1.15] active:brightness-[1.2] group-[.pre]/chart:[transform:scaleX(0)] sp:text-[11px]',
                  barTransition[i][Math.min(k, barTransition[i].length - 1)],
                  t.track === 'main' ? 'bg-fg text-bg' : 'bg-accent-soft text-accent shadow-[inset_0_0_0_1.5px_var(--color-accent)]',
                  { 'ml-[3px]': t.track === 'main' && k > 0 },
                  bar.className,
                ]}
                href={`#${j.id}`}
                title={bar.labelHide ? j.short : undefined}
              >
                <span class:list={[
                  'whitespace-nowrap text-ellipsis',
                  bar.tiny ? 'absolute right-full pr-2 text-accent overflow-visible' : 'px-2.5 overflow-hidden sp:px-1.5',
                  bar.labelHide,
                ]}>{j.short}</span>
              </a>
            );
          })}
        </div>
      ))}
      <div class:list={['col-[2] row-[1/4] grid pointer-events-none', gridColsClass]} aria-hidden="true">
        <span class:list={["row-[1] relative before:content-[''] before:absolute before:left-full before:top-[-6px] before:bottom-4 before:[border-left:1.5px_dashed_var(--color-fg)] before:opacity-50", nowColClass]}><span class="now-dot left-full"></span></span>
      </div>
      <div class:list={['col-[2] row-[3] grid text-[11.5px] text-muted tabular-nums', gridColsClass]} aria-hidden="true">
        {yearLabels.map((y) => <span class:list={['row-[1] whitespace-nowrap', y.className, y.labelHide]}>{y.year}</span>)}
        <span class:list={['row-[1] relative', nowColClass]}><span class="absolute top-0 left-full whitespace-nowrap -translate-x-1/2 text-fg font-bold">現在</span></span>
      </div>
    </div>
    <ol class="list-none m-0 p-0 border-t border-fg" data-reveal data-line>
      {jobs.map((j) => (
        <li class="xp grid grid-cols-[190px_minmax(0,1fr)] gap-6 py-7 border-b border-line last:border-b-0 scroll-mt-6 [&.flash]:animate-[flash_1.2s_var(--ease-soft)] sp:grid-cols-[minmax(0,1fr)] sp:gap-2.5 sp:py-6" id={j.id} data-line>
          <div class="flex flex-wrap content-start items-center gap-2">
            <span class="w-full font-display font-semibold text-[17px] tabular-nums tracking-[0.01em] sp:w-auto sp:text-[15.5px]">{formatYM(j.start)} <i class="not-italic text-muted font-medium">〜</i> {j.end ? formatYM(j.end) : '現在'}</span>
            {j.end === null && <span class="text-[12px] font-bold py-px px-2.5 rounded-full whitespace-nowrap bg-accent text-bg">在籍中</span>}
            {j.track === 'side' && <span class="text-[12px] font-bold py-px px-2.5 rounded-full whitespace-nowrap text-accent shadow-[inset_0_0_0_1px_var(--color-accent)]">副業</span>}
          </div>
          <div class="grid gap-2.5 min-w-0">
            <h3 class="m-0 text-[18px] font-bold leading-[1.5]">{j.company}<small class="block text-[13.5px] font-medium text-muted">{j.role}</small></h3>
            <p class="m-0 text-[15px]">{j.about}</p>
            {j.achievements.length > 0 && <ul class="m-0 pl-[1.1em] grid gap-1 text-[14.5px] text-muted marker:text-accent">{j.achievements.map((a) => <li>{splitCount(a).map((p) => (typeof p === 'number' ? <span class="count" data-count={p}>{p}</span> : p))}</li>)}</ul>}
            {j.tech.length > 0 && <p class="mt-1 mb-0 mx-0 flex flex-wrap gap-1.5">{j.tech.map((name) => <BrandChip brand={brand(name)} size="sm" />)}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
