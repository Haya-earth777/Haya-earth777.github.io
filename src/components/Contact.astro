---
import { contactLinks, profile } from '../data/profile';
import { brandIcons } from '../data/icons';

const card = 'group grid grid-cols-[44px_minmax(0,1fr)_auto] gap-3.5 items-center text-left py-4 px-[18px] border border-line rounded-2xl bg-card text-fg [font:inherit] cursor-pointer [transition:border-color_.25s,transform_.3s_var(--ease-soft),background_.25s] hover:border-fg hover:[transform:translateY(-2px)] active:[transform:scale(.98)] [&.ok]:border-accent [&.ok]:bg-accent-soft';
const iconBox = 'w-11 h-11 rounded-full bg-accent-soft text-accent grid place-items-center';
const action = 'inline-flex items-center gap-[5px] text-[12.5px] font-bold text-muted whitespace-nowrap [transition:color_.25s,transform_.3s_var(--ease-soft)] [&_svg]:w-3.5 [&_svg]:h-3.5 group-hover:text-fg group-[.ok]:text-accent';
---
<section class="grid gap-7 pt-24 pb-16 border-t border-line sp:pt-16 sp:pb-12" aria-labelledby="h-contact" data-line>
  <h2 class="m-0 text-[22px] font-bold leading-[1.3] tracking-[0.06em]" id="h-contact" data-reveal>連絡先</h2>
  <p class="m-0 text-[15px] text-muted" data-reveal>お仕事のご相談はもちろん、ちょっとした質問や情報交換でも、いつでもご連絡ください。</p>
  <div class="grid grid-cols-2 gap-3 tab:grid-cols-[minmax(0,1fr)]" data-reveal>
    <button class={card} id="copy-btn" type="button">
      <span class={iconBox} aria-hidden="true"><svg class="ic w-5 h-5"><use href="#i-mail" /></svg></span>
      <span class="grid min-w-0 leading-[1.45]"><b class="text-[15px] font-bold">メール</b><span class="text-[13px] text-muted [overflow-wrap:anywhere]" id="email">{profile.email}</span></span>
      <span class={action} id="copy-state"><svg class="ic" aria-hidden="true"><use href="#i-copy" /></svg><span>コピー</span></span>
    </button>
    {contactLinks.map((c) => (
      <a class={card} href={c.url} target="_blank" rel="noopener noreferrer">
        {c.mono
          ? <span class:list={[iconBox, 'font-display font-bold text-[18px]']} aria-hidden="true">{c.mono}</span>
          : <span class={iconBox} aria-hidden="true"><svg class="w-[17px] h-[17px] fill-current" viewBox="0 0 24 24"><path d={brandIcons[c.name]} /></svg></span>}
        <span class="grid min-w-0 leading-[1.45]"><b class="text-[15px] font-bold">{c.name}</b><span class="text-[13px] text-muted [overflow-wrap:anywhere]">{c.sub}</span></span>
        <span class:list={[action, 'group-hover:[transform:translate(2px,-2px)]']} aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
