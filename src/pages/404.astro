---
// 存在しない URL を開いたときのページ（GitHub Pages は 404.html を自動で使う）
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---
<Base title={`ページが見つかりません｜${profile.name}`} noindex>
  <main class="max-w-[1120px] mx-auto min-h-[100svh] grid content-center gap-6 py-16">
    <p class="m-0 font-display font-extrabold text-[clamp(96px,22vw,240px)] leading-[0.9] tracking-[-0.04em]" aria-hidden="true">
      <span class="block overflow-hidden pb-[0.06em]"><span class="inline-block animate-[rise_.9s_var(--ease-soft)_both]">404</span></span>
    </p>
    <h1 class="m-0 text-[22px] font-bold leading-[1.4] tracking-[0.06em] animate-[fadeUp_.8s_var(--ease-soft)_.35s_both]">ページが見つかりませんでした</h1>
    <p class="m-0 text-[15px] text-muted animate-[fadeUp_.8s_var(--ease-soft)_.45s_both]">URL が間違っているか、ページが移動した可能性があります。</p>
    <p class="m-0 animate-[fadeUp_.8s_var(--ease-soft)_.55s_both]">
      <a class="inline-flex items-center gap-2 text-[13px] font-bold px-5 py-2.5 rounded-full border border-fg bg-fg text-bg [transition:transform_.3s_var(--ease-soft)] fine:hover:[transform:translateY(-2px)] active:[transform:scale(.96)]" href="/">トップページへ戻る</a>
    </p>
  </main>
</Base>
