---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Career from '../components/Career.astro';
import Strengths from '../components/Strengths.astro';
import Activities from '../components/Activities.astro';
import Hobbies from '../components/Hobbies.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />
  <main class="max-w-[1120px] mx-auto">
    <Skills />
    <Career />
    <Strengths />
    <Activities />
    <Hobbies />
    <Contact />
    <footer class="flex justify-between gap-4 flex-wrap pt-6 pb-10 text-[12.5px] text-muted">
      <span>© {new Date().getFullYear()} Haya</span>
      <a class="text-fg" href="#">ページの先頭へ ↑</a>
    </footer>
  </main>
</Base>
