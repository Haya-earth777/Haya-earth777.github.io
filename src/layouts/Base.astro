---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { profile } from '../data/profile';

const title = profile.name;
const description = `${profile.name} のポートフォリオ。Ruby on Rails・TypeScript・React・Next.js のフルスタックエンジニア。`;
const site = Astro.site?.toString() ?? '/';
const ogImage = new URL('og.png', site).toString();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} のポートフォリオ`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&display=optional" />
  </head>
  <body>
    <IconSprite />
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
