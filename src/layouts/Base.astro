---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { profile } from '../data/profile';
import { EARLY_SCRIPT } from '../scripts/early.mjs';

interface Props {
  /** タブに出すタイトル（省略時は名前） */
  title?: string;
  /** 検索エンジンに載せないページ（404 など） */
  noindex?: boolean;
}
const { title = profile.name, noindex = false } = Astro.props;
const description = `${profile.name}の自己紹介サイト。主にSaaSの開発に携わるフルスタックエンジニアです。`;
const site = Astro.site?.toString() ?? '/';
const ogImage = new URL('og.png', site).toString();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- 動きの準備ができるまで表示用の要素を隠す目印（中身は scripts/early.mjs） -->
    <script is:inline set:html={EARLY_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}の自己紹介サイト`} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- ブラウザの上部の色。OS の設定に合わせ、ページで切り替えたときは main.ts が書き換える -->
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121311" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- 404 ページなど、階層の深い URL でも読めるようにルートからのパスで書く -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&display=optional" />
  </head>
  <body class="m-0 bg-bg text-fg font-body text-[16px] leading-[1.85] tracking-[0.02em] px-8 py-0 [-webkit-font-smoothing:antialiased] tab:px-5 sp:px-4 sp:text-[15px]">
    <IconSprite />
    <div class="progress" aria-hidden="true"></div>
    <div
      class="cursor fixed left-0 top-0 w-3 h-3 -mt-1.5 -ml-1.5 z-50 rounded-full bg-white mix-blend-difference pointer-events-none opacity-0 hidden [transition:width_.3s_var(--ease-soft),height_.3s_var(--ease-soft),margin_.3s_var(--ease-soft),opacity_.3s] [&.on]:opacity-100 [&.big]:w-[52px] [&.big]:h-[52px] [&.big]:-mt-[26px] [&.big]:-ml-[26px] fine:block touch:hidden"
      aria-hidden="true"
    ></div>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
